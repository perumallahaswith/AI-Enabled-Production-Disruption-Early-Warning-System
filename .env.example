# ==============================================================================
# SEMICONDUCTOR FAB EARLY WARNING PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Metadata
APP_NAME="AI-Enabled Production Disruption Early Warning System"
APP_ENV="development"
APP_DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-production-fab-early-warning-key-change-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Fab Facility Metadata
FAB_NAME="Fab Alpha - Sub-10nm Advanced Lithography & Etch Unit"
FAB_LOCATION="Building C - Cleanroom Bay 04"
DEFAULT_CURRENCY="USD"
COST_PER_WAFER=1450.00
COST_PER_LOT=36250.00
DOWNTIME_COST_PER_HOUR=25000.00

# Database Configuration
# Local SQLite default; Use postgresql+psycopg2://user:pass@host:5432/fab_db for production
DATABASE_URL="sqlite:///./semiconductor_fab.db"

# Early Warning Engine Thresholds (0 - 100 Scale)
THRESHOLD_NORMAL=20.0
THRESHOLD_LOW=40.0
THRESHOLD_MEDIUM=60.0
THRESHOLD_HIGH=80.0
THRESHOLD_CRITICAL=100.0

# Risk Prioritization Weights (Sum = 1.0)
WEIGHT_PREDICTION_RISK=0.35
WEIGHT_ANOMALY_SEVERITY=0.25
WEIGHT_BUSINESS_IMPACT=0.20
WEIGHT_TREND_ESCALATION=0.10
WEIGHT_PRODUCTION_CRITICALITY=0.10

# Email & Notification Settings (SMTP)
SMTP_ENABLED=False
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM="alerts-noreply@semifab.local"
EMAIL_ALERT_RECIPIENTS="supervisor@semifab.local,maintenance-lead@semifab.local,plant-manager@semifab.local"
ALERT_COOLDOWN_MINUTES=15

# Optional LLM Integration (Graceful Template Fallback if Empty)
LLM_ENABLED=False
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
LLM_PROVIDER="openai"

# Server Host & Ports
API_HOST="127.0.0.1"
API_PORT=8000
DASHBOARD_PORT=8501
BACKEND_API_URL="http://127.0.0.1:8000"
